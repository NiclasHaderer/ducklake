# name: test/sql/retry/sort_spec_commit_retry.test
# description: Data files reference the committed sort spec when the commit that writes the spec is retried
# group: [retry]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/sort_spec_commit_retry', METADATA_CATALOG 'sort_retry_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
SET ducklake_retry_wait_ms = 0

statement ok
CREATE TABLE ducklake.other(i INTEGER)

statement ok
CREATE TABLE ducklake.t(i INTEGER, j INTEGER)

statement ok
SET VARIABLE t_id = (SELECT table_id FROM sort_retry_meta.ducklake_table WHERE table_name = 't')

# a spec set in the retried transaction
statement ok con1
BEGIN

statement ok con1
ALTER TABLE ducklake.t SET SORTED BY (i)

statement ok con1
INSERT INTO ducklake.t VALUES (2, 1), (1, 2)

statement ok con2
INSERT INTO ducklake.other VALUES (1)

# the commit of con2 took the next snapshot id, so the commit of con1 is retried
statement ok con1
COMMIT

statement ok
SET VARIABLE first_sort = (SELECT sort_id FROM sort_retry_meta.ducklake_sort_info WHERE table_id = getvariable('t_id') AND end_snapshot IS NULL)

query I
SELECT list(sort_id) = [getvariable('first_sort')] FROM sort_retry_meta.ducklake_data_file WHERE table_id = getvariable('t_id')
----
true

# a rename rewrites the committed spec, and files written before it move to the rewritten spec
statement ok con1
BEGIN

statement ok con1
INSERT INTO ducklake.t VALUES (4, 3), (3, 4)

statement ok con1
ALTER TABLE ducklake.t RENAME COLUMN i TO k

statement ok con1
INSERT INTO ducklake.t VALUES (6, 5), (5, 6)

statement ok con1
ALTER TABLE ducklake.t SET SORTED BY (j)

statement ok con1
INSERT INTO ducklake.t VALUES (8, 7), (7, 8)

statement ok con2
INSERT INTO ducklake.other VALUES (2)

statement ok con1
COMMIT

statement ok
SET VARIABLE sorts = (SELECT list(sort_id) FROM sort_retry_meta.ducklake_sort_info WHERE table_id = getvariable('t_id'))

statement ok
SET VARIABLE first_file = (SELECT min(data_file_id) FROM sort_retry_meta.ducklake_data_file WHERE table_id = getvariable('t_id'))

# the two files before the SET SORTED BY share the rewritten spec, none keeps the spec the rename ended
query IIII
SELECT count(*), count(DISTINCT sort_id), count(*) FILTER (WHERE sort_id = getvariable('first_sort')), count(*) FILTER (WHERE list_contains(getvariable('sorts'), sort_id))
FROM sort_retry_meta.ducklake_data_file WHERE table_id = getvariable('t_id') AND data_file_id > getvariable('first_file')
----
3	2	0	3

query II
SELECT k, j FROM ducklake.t ORDER BY rowid
----
1	2
2	1
3	4
4	3
5	6
6	5
8	7
7	8
